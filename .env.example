# 复制为 .env 后填写（不要提交 .env）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
PORT=8765

# Supabase（Settings → API）
# Publishable key 填到 SUPABASE_ANON_KEY；切勿把 Secret/service_role 给前端
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# 联网搜索（默认 DuckDuckGo，免费无需 Key）
# WEB_SEARCH_PROVIDER=duckduckgo
# 关闭联网：WEB_SEARCH_PROVIDER=off
# 可选付费/额度更好的源：
# SERPER_API_KEY=
# BOCHA_API_KEY=

# 开发：npm run dev  → 前端 http://127.0.0.1:5173  后端 http://127.0.0.1:8765
# 生产：npm run build && npm start
